import { ListView } from "std-widgets.slint";
import { Theme, Icons, Frame } from "theme.slint";

export struct TreeRow {
    kind: int,
    id: int,
    depth: int,
    text: string,
    align: int,
    line: int,
    icon: int,
    count: int,
    current: bool,
    talking: bool,
    me: bool,
    mic-muted: bool,
    sound-muted: bool,
    away: bool,
    tag: string,
    whispering: bool,
    commander: bool,
    foldable: bool,
    folded: bool,
    badges: int,
    badge-tint: int,
    badge-a: image,
    badge-b: image,
    badge-c: image,
    badge-d: image,
}

export struct ServerTile {
    id: int,
    initials: string,
    name: string,
    detail: string,
    viewed: bool,
    connected: bool,
    talking: bool,
    icon: image,
    has-icon: bool,
}

export struct BookmarkRow {
    index: int,
    initials: string,
    name: string,
    address: string,
    nickname: string,
    identity-index: int,
}

export struct ChatRow {
    time: string,
    kind: int,
    name: string,
    text: string,
}

export struct IdentityRow {
    name: string,
    uid: string,
    detail: string,
}

export struct WhisperKeyRow {
    key: string,
    summary: string,
    note: string,
}

export struct PickRow {
    person: bool,
    depth: int,
    text: string,
    ticked: bool,
    gone: bool,
}

export component Icon inherits Image {
    in property <color> tint: Theme.drift;
    width: 16px;
    height: 16px;
    image-fit: contain;
    colorize: root.tint;
}

export component Pressable inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> focusable: true;
    out property <bool> hovered: touch.has-hover && root.enabled;
    callback clicked();
    callback double-clicked();
    callback context();

    scope := FocusScope {
        enabled: root.enabled && root.focusable;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.double-clicked();
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                root.context();
            }
        }
    }

    @children

    Rectangle {
        border-radius: root.border-radius;
        border-width: scope.has-focus ? 2px : 0px;
        border-color: Theme.lure;
    }
}

export component Btn inherits Pressable {
    in property <string> text;
    in property <bool> primary;
    in property <bool> danger;

    height: 32px;
    min-width: label.preferred-width + 28px;
    border-radius: 8px;
    opacity: root.enabled ? 1 : 0.45;
    background: root.primary ? (root.hovered ? Theme.lure.brighter(10%) : Theme.lure) : (root.hovered ? Theme.current : Theme.shoal);

    Rectangle {
        border-radius: 8px;
        border-width: root.primary ? 0px : 1px;
        border-color: Theme.hairline;
    }

    label := Text {
        text: root.text;
        color: root.primary ? Theme.on-lure : (root.danger ? Theme.coral-bright : Theme.foam);
        font-size: Theme.text;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component IconButton inherits Pressable {
    in property <image> icon;
    in property <bool> active;
    in property <bool> alert;

    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: root.alert ? Theme.coral.with-alpha(0.18) : (root.hovered ? Theme.current : (root.active ? Theme.shoal : transparent));

    Icon {
        source: root.icon;
        tint: root.alert ? Theme.coral : (root.active || root.hovered ? Theme.foam : Theme.drift);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

export component Tile inherits Pressable {
    in property <string> label;
    in property <bool> viewed;
    in property <bool> connected;
    in property <bool> talking;
    in property <length> size: 34px;

    width: root.size;
    height: root.size;
    border-radius: root.size * 0.3;
    background: root.viewed ? Theme.lure : (root.hovered ? Theme.current : Theme.shoal);
    border-width: root.viewed ? 0px : (root.connected ? 2px : 1px);
    border-color: root.connected ? Theme.drift : Theme.hairline;

    Text {
        text: root.label;
        color: root.viewed ? Theme.on-lure : (root.connected ? Theme.foam : Theme.drift);
        font-size: root.size * 0.36;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.talking: Rectangle {
        x: parent.width - 8px;
        y: parent.height - 8px;
        width: 11px;
        height: 11px;
        border-radius: 5.5px;
        background: Theme.lure;
        border-width: 2px;
        border-color: Theme.trench;
    }
}

export component Meter inherits Rectangle {
    in property <float> level;
    in property <float> marker: -1;
    in property <bool> active;

    height: 6px;
    border-radius: 3px;
    background: Theme.shoal;
    clip: true;

    Rectangle {
        x: 0px;
        y: 0px;
        height: parent.height;
        width: parent.width * max(0, min(1, root.level));
        border-radius: 3px;
        background: root.active ? Theme.lure : Theme.drift;
    }

    if root.marker >= 0: Rectangle {
        x: parent.width * min(1, root.marker) - 1px;
        y: 0px;
        width: 2px;
        height: parent.height;
        background: Theme.foam;
    }
}

export component Slide inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> step: 1;
    in-out property <float> value;
    in property <float> level: -1;
    in property <bool> level-active;
    callback changed();

    property <float> fraction: max(0, min(1, (root.value - root.minimum) / (root.maximum - root.minimum)));

    height: 28px;
    min-width: 120px;

    function set-fraction(f: float) {
        root.value = root.minimum + (root.maximum - root.minimum) * max(0, min(1, f));
        root.changed();
    }

    scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.LeftArrow) {
                root.value = max(root.minimum, root.value - root.step);
                root.changed();
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.value = min(root.maximum, root.value + root.step);
                root.changed();
                return accept;
            }
            return reject;
        }
    }

    Rectangle {
        y: (parent.height - 8px) / 2;
        height: 8px;
        border-radius: 4px;
        background: Theme.trench;
        clip: true;

        Rectangle {
            x: 0px;
            y: 0px;
            height: parent.height;
            width: parent.width * (root.level >= 0 ? max(0, min(1, root.level)) : root.fraction);
            background: root.level >= 0 && root.level-active ? Theme.lure : Theme.drift;
        }
    }

    Rectangle {
        x: max(0px, min(parent.width - self.width, parent.width * root.fraction - self.width / 2));
        y: (parent.height - self.height) / 2;
        width: touch.has-hover || touch.pressed ? 16px : 14px;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.foam;
        border-width: scope.has-focus ? 2px : 0px;
        border-color: Theme.lure;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        moved => {
            if (self.pressed) {
                root.set-fraction(self.mouse-x / root.width);
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.set-fraction(self.mouse-x / root.width);
            }
        }
    }
}

export component Field inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <bool> password;
    in property <bool> enabled: true;
    callback accepted();
    callback edited();

    height: 34px;
    border-radius: 8px;
    background: Theme.trench;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.lure : Theme.hairline;
    clip: true;

    public function focus-input() {
        input.focus();
    }

    if input.text == "": Text {
        x: 12px;
        y: 0px;
        height: parent.height;
        width: parent.width - 24px;
        text: root.placeholder;
        color: Theme.drift;
        font-size: Theme.text;
        vertical-alignment: center;
        overflow: elide;
    }

    input := TextInput {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        vertical-alignment: center;
        single-line: true;
        enabled: root.enabled;
        color: Theme.foam;
        font-size: Theme.text;
        input-type: root.password ? InputType.password : InputType.text;
        selection-background-color: Theme.current;
        selection-foreground-color: Theme.foam;
        accepted => {
            root.accepted();
        }
        edited => {
            root.edited();
        }
    }
}

component TickBox inherits Rectangle {
    in property <bool> checked;
    in property <bool> dim;

    width: 18px;
    height: 18px;
    border-radius: 5px;
    border-width: 1.5px;
    border-color: root.checked && !root.dim ? Theme.foam : Theme.drift;
    background: root.checked ? (root.dim ? Theme.drift : Theme.foam) : transparent;

    if root.checked: Icon {
        source: Icons.check;
        tint: Theme.trench;
        width: 14px;
        height: 14px;
        x: 2px;
        y: 2px;
    }
}

export component Check inherits Pressable {
    in-out property <bool> checked;
    in property <string> text;
    callback toggled();

    height: 30px;
    border-radius: 6px;
    background: root.hovered ? Theme.current.with-alpha(0.35) : transparent;
    clicked => {
        root.checked = !root.checked;
        root.toggled();
    }

    HorizontalLayout {
        padding-left: 2px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;

            TickBox {
                checked: root.checked;
            }
        }

        Text {
            text: root.text;
            color: Theme.foam;
            font-size: Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    callback selected();

    height: 34px;
    border-radius: 8px;
    background: Theme.trench;

    HorizontalLayout {
        padding: 3px;
        spacing: 2px;

        for label[i] in root.options: Pressable {
            border-radius: 6px;
            min-width: caption.preferred-width + 22px;
            background: i == root.current ? Theme.current : (self.hovered ? Theme.shoal : transparent);
            clicked => {
                root.current = i;
                root.selected();
            }

            caption := Text {
                text: label;
                color: i == root.current ? Theme.foam : Theme.drift;
                font-size: Theme.text;
                font-weight: i == root.current ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

export component Dropdown inherits Pressable {
    in property <[string]> model;
    in-out property <int> current-index;
    in property <string> placeholder: "Nothing to choose from";
    callback selected();

    property <length> list-height: min(246px, root.model.length * 30px + 8px);
    property <bool> opens-up: root.absolute-position.y + root.height + root.list-height + 10px > Frame.height && root.absolute-position.y - root.list-height - 10px >= 0px;

    height: 34px;
    border-radius: 8px;
    background: Theme.trench;
    clicked => {
        if (root.model.length > 0) {
            popup.show();
        }
    }

    Rectangle {
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.hairline;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;

        Text {
            text: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : root.placeholder;
            color: root.current-index >= 0 && root.current-index < root.model.length ? Theme.foam : Theme.drift;
            font-size: Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        VerticalLayout {
            alignment: center;

            Icon {
                source: Icons.chevron;
            }
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.opens-up ? -root.list-height - 4px : root.height + 4px;
        width: root.width;
        height: root.list-height;

        Rectangle {
            background: Theme.shoal;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.hairline;
            clip: true;

            ListView {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;

                for item[i] in root.model: Rectangle {
                    height: 30px;
                    border-radius: 6px;
                    background: option.has-hover || i == root.current-index ? Theme.current : transparent;

                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        text: item;
                        color: Theme.foam;
                        font-size: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    option := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current-index = i;
                            root.selected();
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

export component KeyChip inherits Rectangle {
    in property <string> text;
    in property <string> empty-text: "Choose a key";
    in property <bool> listening;
    in property <bool> removable: true;
    callback clicked();
    callback removed();

    height: 34px;
    horizontal-stretch: 0;
    border-radius: 8px;
    background: Theme.trench;

    HorizontalLayout {
        Pressable {
            border-radius: 8px;
            horizontal-stretch: 1;
            min-width: 64px;
            preferred-width: label.preferred-width + 26px;
            background: self.hovered ? Theme.current.with-alpha(0.5) : transparent;
            clicked => {
                root.clicked();
            }

            label := Text {
                x: 13px;
                width: parent.width - 26px;
                text: root.listening ? "Press a key…" : (root.text == "" ? root.empty-text : root.text);
                color: root.listening || root.text == "" ? Theme.drift-bright : Theme.foam;
                font-size: Theme.text;
                font-weight: root.listening || root.text == "" ? 400 : 600;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if root.removable && root.text != "" && !root.listening: Pressable {
            width: 28px;
            border-radius: 8px;
            background: self.hovered ? Theme.current.with-alpha(0.5) : transparent;
            clicked => {
                root.removed();
            }

            Icon {
                source: Icons.close;
                tint: parent.hovered ? Theme.foam : Theme.drift;
                width: 12px;
                height: 12px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }

    Rectangle {
        border-radius: 8px;
        border-width: root.listening ? 2px : 1px;
        border-color: root.listening ? Theme.lure : Theme.hairline;
    }
}

export component PickRowView inherits Pressable {
    in property <PickRow> entry;

    height: 28px;
    border-radius: 6px;
    background: self.hovered ? Theme.shoal : transparent;

    HorizontalLayout {
        padding-left: 8px + root.entry.depth * 16px;
        padding-right: 10px;
        spacing: 9px;

        VerticalLayout {
            alignment: center;

            TickBox {
                checked: root.entry.ticked;
                dim: root.entry.gone;
            }
        }

        if !root.entry.person: VerticalLayout {
            alignment: center;

            Icon {
                source: Icons.speaker;
                width: 14px;
                height: 14px;
            }
        }

        Text {
            text: root.entry.text;
            color: root.entry.gone ? Theme.drift : Theme.foam;
            font-size: Theme.text;
            font-weight: root.entry.person ? 400 : 600;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.entry.gone: Text {
            text: "not here now";
            color: Theme.drift;
            font-size: 11.5px;
            vertical-alignment: center;
        }
    }
}

component Rule inherits VerticalLayout {
    alignment: center;
    horizontal-stretch: 1;

    Rectangle {
        height: 1px;
        background: Theme.hairline;
    }
}

component Dashes inherits Rectangle {
    in property <length> dash: 6px;
    in property <length> gap: 4px;
    in property <length> thickness: 1px;

    clip: true;
    horizontal-stretch: 1;

    HorizontalLayout {
        x: 0px;
        y: (parent.height - root.thickness) / 2;
        height: root.thickness;
        width: 120 * (root.dash + root.gap);
        spacing: root.gap;

        for i in 120: Rectangle {
            width: root.dash;
            background: Theme.drift.with-alpha(0.45);
        }
    }
}

component FoldArrow inherits Rectangle {
    in property <bool> active;
    in property <bool> folded;
    out property <bool> hovered: touch.has-hover && root.active;
    callback clicked();

    width: 20px;

    if root.active: Icon {
        source: root.folded ? Icons.chevron-right : Icons.chevron;
        tint: root.hovered ? Theme.foam : Theme.drift;
        width: 14px;
        height: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        enabled: root.active;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component Badge inherits Rectangle {
    in property <image> picture;
    in property <bool> tinted;

    width: 16px;
    height: 16px;

    if root.tinted: Image {
        width: 16px;
        height: 16px;
        source: root.picture;
        image-fit: contain;
        colorize: Theme.drift;
    }

    if !root.tinted: Image {
        width: 16px;
        height: 16px;
        source: root.picture;
        image-fit: contain;
    }
}

component BadgeStrip inherits HorizontalLayout {
    in property <TreeRow> entry;

    spacing: 3px;

    for slot in root.entry.badges: VerticalLayout {
        alignment: center;

        Badge {
            picture: slot == 0 ? root.entry.badge-a : (slot == 1 ? root.entry.badge-b : (slot == 2 ? root.entry.badge-c : root.entry.badge-d));
            tinted: Math.mod(Math.floor(root.entry.badge-tint / Math.pow(2, slot)), 2) >= 1;
        }
    }
}

export component TreeRowView inherits Rectangle {
    in property <TreeRow> entry;
    callback activated();
    callback fold-clicked();
    callback context-clicked();

    height: Theme.row;

    if root.entry.kind == 0 && root.entry.align == 3: Rectangle {
        x: 12px;
        width: parent.width - 24px;
        clip: true;

        Text {
            x: 0px;
            width: parent.width;
            text: root.entry.text;
            color: Theme.drift;
            font-size: Theme.small;
            font-weight: 600;
            vertical-alignment: center;
            overflow: clip;
        }
    }

    if root.entry.kind == 0 && root.entry.align != 3: HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;

        if root.entry.align == 1: Rule { }

        Text {
            text: root.entry.text;
            color: root.entry.align == 1 ? Theme.foam.with-alpha(0.85) : Theme.drift;
            font-size: Theme.small;
            font-weight: root.entry.align == 2 ? 400 : 600;
            vertical-alignment: center;
            horizontal-alignment: root.entry.align == 2 ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            horizontal-stretch: root.entry.align == 1 ? 0 : 1;
            overflow: elide;
        }

        if root.entry.align == 1: Rule { }
    }

    if root.entry.kind == 1: HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;

        if root.entry.line == 0: Rule { }

        if root.entry.line == 1: Dashes { }

        if root.entry.line == 2: Dashes {
            dash: 2px;
            gap: 4px;
            thickness: 2px;
        }
    }

    if root.entry.kind == 3: Pressable {
        focusable: false;
        border-radius: 6px;
        background: root.entry.current ? Theme.current : (self.hovered || arrow.hovered ? Theme.shoal : transparent);
        double-clicked => {
            root.activated();
        }
        context => {
            root.context-clicked();
        }

        HorizontalLayout {
            padding-left: 2px + root.entry.depth * 16px;
            padding-right: 10px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 2px;
                horizontal-stretch: 0;

                arrow := FoldArrow {
                    active: root.entry.foldable;
                    folded: root.entry.folded;
                    clicked => {
                        root.fold-clicked();
                    }
                }

                VerticalLayout {
                    alignment: center;

                    Icon {
                        source: root.entry.icon == 1 ? Icons.lock : (root.entry.icon == 2 ? Icons.note : Icons.speaker);
                        tint: root.entry.talking ? Theme.lure : Theme.drift;
                    }
                }
            }

            Text {
                text: root.entry.text;
                color: Theme.foam;
                font-size: Theme.text;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            if root.entry.badges > 0: BadgeStrip {
                entry: root.entry;
            }

            if root.entry.count > 0: Text {
                text: "" + root.entry.count;
                color: root.entry.current ? Theme.drift-bright : Theme.drift;
                font-size: Theme.small;
                vertical-alignment: center;
            }
        }
    }

    if root.entry.kind == 4: Pressable {
        focusable: false;
        border-radius: 6px;
        background: self.hovered ? Theme.shoal : transparent;
        double-clicked => {
            root.activated();
        }
        context => {
            root.context-clicked();
        }

        HorizontalLayout {
            padding-left: 44px + root.entry.depth * 16px;
            padding-right: 10px;
            spacing: 6px;

            VerticalLayout {
                alignment: center;

                Rectangle {
                    width: 17px;
                    height: 17px;

                    Rectangle {
                        width: root.entry.talking ? 17px : 9px;
                        height: self.width;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: self.width / 2;
                        background: Theme.lure;
                        opacity: root.entry.talking ? 0.3 : 0;
                        animate width, opacity {
                            duration: 250ms;
                            easing: ease-out;
                        }
                    }

                    Rectangle {
                        x: 4px;
                        y: 4px;
                        width: 9px;
                        height: 9px;
                        border-radius: 4.5px;
                        background: root.entry.talking ? Theme.lure : Theme.drift;
                        opacity: root.entry.talking ? 1 : 0.55;
                    }
                }
            }

            Text {
                text: root.entry.text;
                color: root.entry.talking ? Theme.lure : (root.entry.away ? Theme.drift : Theme.foam);
                font-size: Theme.text;
                font-weight: root.entry.me ? 600 : 400;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            if root.entry.badges > 0: BadgeStrip {
                entry: root.entry;
            }

            if root.entry.commander: VerticalLayout {
                alignment: center;

                Icon {
                    source: Icons.commander;
                    width: 14px;
                    height: 14px;
                }
            }

            if root.entry.mic-muted: VerticalLayout {
                alignment: center;

                Icon {
                    source: Icons.mic-off;
                    tint: Theme.coral;
                    width: 14px;
                    height: 14px;
                }
            }

            if root.entry.sound-muted: VerticalLayout {
                alignment: center;

                Icon {
                    source: Icons.ear-off;
                    tint: Theme.coral;
                    width: 14px;
                    height: 14px;
                }
            }

            if root.entry.tag != "": Text {
                text: root.entry.tag;
                color: Theme.drift;
                font-size: 11.5px;
                vertical-alignment: center;
            }
        }
    }
}

export component ChatRowView inherits Rectangle {
    in property <ChatRow> entry;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 8px;

        Text {
            width: 34px;
            text: root.entry.time;
            color: Theme.drift;
            font-size: 11.5px;
            vertical-alignment: top;
        }

        if root.entry.kind == 1 || root.entry.kind == 2: Text {
            text: root.entry.name;
            color: root.entry.kind == 2 ? Theme.lure : Theme.foam;
            font-size: Theme.chat;
            font-weight: 600;
            vertical-alignment: top;
        }

        Text {
            text: root.entry.text;
            color: root.entry.kind == 0 ? Theme.drift : (root.entry.kind == 3 ? Theme.coral-bright : Theme.foam);
            font-size: root.entry.kind == 0 ? Theme.small : Theme.chat;
            wrap: word-wrap;
            vertical-alignment: top;
            horizontal-stretch: 1;
        }
    }
}
