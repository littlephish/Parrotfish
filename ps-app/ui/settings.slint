import { ListView, ScrollView, AboutSlint, Palette } from "std-widgets.slint";
import { Theme, Icons, Frame } from "theme.slint";
import { Pressable, Btn, Tile, Field, Dropdown, Check, Segmented, Slide, KeyChip, PickRowView, BookmarkRow, IdentityRow, WhisperKeyRow, PickRow } from "widgets.slint";

component Caption inherits Text {
    width: 150px;
    height: 34px;
    color: Theme.drift;
    font-size: Theme.text;
    vertical-alignment: center;
}

component Hint inherits Text {
    color: Theme.drift;
    font-size: Theme.small;
    wrap: word-wrap;
}

component Reading inherits Text {
    width: 56px;
    color: Theme.drift;
    font-size: Theme.text;
    horizontal-alignment: right;
    vertical-alignment: center;
}

component Heading inherits Text {
    color: Theme.foam;
    font-size: 15px;
    font-weight: 600;
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.hairline;
}

export component SettingsWindow inherits Window {
    title: "PhishSpeak settings";
    preferred-width: 700px;
    preferred-height: 600px;
    min-width: 640px + root.scale-nudge * 0.01px;
    min-height: 590px;
    background: Theme.reef;
    default-font-size: Theme.text;

    in-out property <int> tab;

    in property <[string]> input-devices;
    in property <[string]> output-devices;
    in-out property <int> input-index;
    in-out property <int> output-index;
    in-out property <int> tx-mode;
    in-out property <float> vad-threshold: -40;
    in-out property <float> mic-gain: 100;
    in-out property <float> output-volume: 100;
    in-out property <bool> mic-test;
    in property <float> input-level;
    in property <bool> transmitting;
    in property <string> mic-status;
    in property <string> sound-status;
    in property <string> talk-hint;
    in-out property <bool> echo-cancel;
    in-out property <bool> noise-suppression;
    in-out property <bool> auto-gain;
    in-out property <float> cue-volume: 50;
    in property <string> echo-status;

    in property <[IdentityRow]> identities;
    in-out property <string> import-path;
    in property <string> identity-note;

    in property <[BookmarkRow]> bookmarks;
    in property <[string]> identity-names;
    in-out property <int> bm-index: -1;
    in-out property <string> bm-name;
    in-out property <string> bm-address;
    in-out property <string> bm-nickname;
    in-out property <int> bm-identity;
    in property <[string]> bm-channels;
    in-out property <int> bm-channel;
    in-out property <string> bm-server-password;
    in-out property <string> bm-channel-password;
    in-out property <bool> bm-auto;
    in property <string> bm-channel-hint;
    in property <string> bm-note;

    in property <[string]> talk-keys;
    in property <bool> can-add-talk: true;
    in property <int> listening: -1;
    in-out property <float> talk-release;
    in property <string> talk-release-text: "Off";
    in property <string> shortcut-note;
    in property <int> shortcut-note-place;
    in property <[WhisperKeyRow]> whisper-keys;
    in property <bool> can-add-whisper: true;
    in property <string> reply-key;
    in property <string> mute-mic-key;
    in property <string> mute-sound-key;
    in-out property <bool> allow-whispers: true;

    in property <bool> editor-open;
    in property <string> editor-title;
    in property <string> editor-key;
    in-out property <int> editor-kind;
    in property <string> editor-hint;
    in property <[PickRow]> editor-rows;
    in-out property <int> editor-who;
    in property <[string]> editor-groups;
    in-out property <int> editor-group: -1;
    in-out property <int> editor-scope;
    in property <string> editor-note;
    in property <bool> editor-can-save;

    in-out property <int> fold-mode: 1;
    in-out property <bool> sp-shown;
    in-out property <bool> sp-locked;
    in-out property <bool> sp-on-top: true;
    in-out property <bool> sp-all;
    in-out property <float> sp-opacity: 85;
    in-out property <float> sp-linger: 10;
    in-out property <bool> links-on;
    in property <string> links-note;

    in property <string> version;
    in property <float> scale-nudge;

    property <bool> editing: root.tab == 4 && root.editor-open;
    property <[string]> scope-names: ["Everywhere", "My channel", "The channel above mine", "Every channel above mine", "My channel and all below it", "My whole branch, from the top", "The channels right below mine"];
    property <[string]> scope-hints: ["Reaches every channel on the server.", "Reaches your channel only.", "Reaches the channel yours is inside, and no other.", "Reaches the channel yours is inside, the one that is inside, and so on up. Not your own channel.", "Reaches your channel and every channel under it, however deep.", "Reaches the top-level channel you are under and everything inside it, including the branches beside yours.", "Reaches the channels directly under yours. Not the ones under those."];

    callback audio-changed();
    callback input-device-selected();
    callback output-device-selected();
    callback new-identity();
    callback import-identity();
    callback bookmark-picked(index: int);
    callback bookmark-new();
    callback bookmark-saved();
    callback bookmark-removed();
    callback bookmark-channel-selected();
    callback talk-key-change(index: int);
    callback talk-key-add();
    callback talk-key-remove(index: int);
    callback shortcut-changed();
    callback whisper-key-add();
    callback whisper-key-edit(index: int);
    callback whisper-key-remove(index: int);
    callback whisper-key-change(index: int);
    callback reply-key-change();
    callback reply-key-clear();
    callback action-key-change(which: int);
    callback action-key-clear(which: int);
    callback editor-key-change();
    callback editor-key-clear();
    callback editor-toggle(index: int);
    callback editor-changed();
    callback editor-save();
    callback editor-cancel();
    callback view-changed();
    callback speakers-changed();
    callback links-changed();
    callback done();

    forward-focus: keys;
    init => {
        Frame.height = self.height;
        Palette.color-scheme = ColorScheme.dark;
    }
    changed height => {
        Frame.height = self.height;
    }

    keys := FocusScope {
        capture-key-pressed(event) => {
            if (root.listening >= 0) {
                return accept;
            }
            return reject;
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.editing) {
                    root.editor-cancel();
                } else {
                    root.done();
                }
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            HorizontalLayout {
                height: 44px;
                padding-left: 14px;
                spacing: 2px;

                for label[i] in ["Microphone", "Sound", "Identities", "Bookmarks", "Shortcuts", "Channels", "About"]: Pressable {
                    min-width: caption.preferred-width + 24px;
                    clicked => {
                        root.tab = i;
                    }

                    caption := Text {
                        text: label;
                        color: i == root.tab || parent.hovered ? Theme.foam : Theme.drift;
                        font-size: Theme.text;
                        font-weight: i == root.tab ? 600 : 400;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        x: 10px;
                        y: parent.height - 2px;
                        width: parent.width - 20px;
                        height: 2px;
                        background: i == root.tab ? Theme.lure : transparent;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }
            }

            Divider { }

            Rectangle {
                vertical-stretch: 1;

                if root.tab == 0: VerticalLayout {
                    alignment: start;
                    padding: 20px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 16px;

                        Caption {
                            text: "Microphone";
                        }

                        VerticalLayout {
                            spacing: 5px;

                            Dropdown {
                                model: root.input-devices;
                                current-index <=> root.input-index;
                                selected => {
                                    root.input-device-selected();
                                }
                            }

                            Hint {
                                min-height: 32px;
                                text: root.mic-status;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 16px;

                        Caption {
                            text: "Send my voice";
                        }

                        Segmented {
                            options: ["When I speak", "While I hold a key", "Always"];
                            current <=> root.tx-mode;
                            selected => {
                                root.audio-changed();
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }

                    if root.tx-mode == 0: HorizontalLayout {
                        spacing: 16px;

                        Caption {
                            text: "Speaking level";
                        }

                        VerticalLayout {
                            spacing: 4px;

                            HorizontalLayout {
                                spacing: 10px;

                                Slide {
                                    minimum: -70;
                                    maximum: 0;
                                    value <=> root.vad-threshold;
                                    level: root.input-level;
                                    level-active: root.transmitting;
                                    changed => {
                                        root.audio-changed();
                                    }
                                }

                                Reading {
                                    text: "\{round(root.vad-threshold)} dB";
                                }
                            }

                            Hint {
                                text: "Talk normally and drag the marker just below where the bar reaches. Quieter sounds are not sent.";
                            }
                        }
                    }

                    if root.tx-mode == 1: HorizontalLayout {
                        spacing: 16px;

                        Caption {
                            text: "";
                        }

                        Hint {
                            text: root.talk-hint;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: 16px;

                        Caption {
                            text: "Microphone boost";
                        }

                        Slide {
                            minimum: 0;
                            maximum: 300;
                            step: 5;
                            value <=> root.mic-gain;
                            changed => {
                                root.audio-changed();
                            }
                        }

                        Reading {
                            text: "\{round(root.mic-gain)}%";
                        }
                    }

                    HorizontalLayout {
                        spacing: 16px;

                        Caption {
                            text: "Clean-up";
                        }

                        VerticalLayout {
                            spacing: 2px;

                            Check {
                                text: "Take steady background noise out of my voice";
                                checked <=> root.noise-suppression;
                                toggled => {
                                    root.audio-changed();
                                }
                            }

                            Check {
                                text: "Keep my voice at an even level";
                                checked <=> root.auto-gain;
                                toggled => {
                                    root.audio-changed();
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 16px;

                        Caption {
                            text: "Echo";
                        }

                        VerticalLayout {
                            spacing: 4px;

                            Check {
                                text: "Take my speakers' sound out of my microphone";
                                checked <=> root.echo-cancel;
                                toggled => {
                                    root.audio-changed();
                                }
                            }

                            Hint {
                                text: root.echo-status;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 16px;

                        Caption {
                            text: "Test";
                        }

                        Check {
                            text: "Play my microphone back to me";
                            checked <=> root.mic-test;
                            toggled => {
                                root.audio-changed();
                            }
                        }
                    }
                }

                if root.tab == 1: VerticalLayout {
                    alignment: start;
                    padding: 20px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 16px;

                        Caption {
                            text: "Speakers";
                        }

                        VerticalLayout {
                            spacing: 5px;

                            Dropdown {
                                model: root.output-devices;
                                current-index <=> root.output-index;
                                selected => {
                                    root.output-device-selected();
                                }
                            }

                            Hint {
                                text: root.sound-status;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 16px;

                        Caption {
                            text: "Volume";
                        }

                        Slide {
                            minimum: 0;
                            maximum: 200;
                            step: 5;
                            value <=> root.output-volume;
                            changed => {
                                root.audio-changed();
                            }
                        }

                        Reading {
                            text: "\{round(root.output-volume)}%";
                        }
                    }

                    HorizontalLayout {
                        spacing: 16px;

                        Caption {
                            text: "Event sounds";
                        }

                        Slide {
                            minimum: 0;
                            maximum: 100;
                            step: 5;
                            value <=> root.cue-volume;
                            changed => {
                                root.audio-changed();
                            }
                        }

                        Reading {
                            text: root.cue-volume < 1 ? "off" : "\{round(root.cue-volume)}%";
                        }
                    }
                }

                if root.tab == 2: VerticalLayout {
                    alignment: start;
                    padding: 20px;
                    spacing: 8px;

                    Hint {
                        text: "An identity is how a server recognises you. Each bookmark can use a different one.";
                    }

                    for identity in root.identities: Rectangle {
                        height: 44px;
                        border-radius: 8px;
                        background: Theme.shoal;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;

                            Text {
                                text: identity.name;
                                color: Theme.foam;
                                font-size: Theme.text;
                                font-weight: 600;
                                vertical-alignment: center;
                            }

                            Text {
                                text: identity.uid;
                                color: Theme.drift;
                                font-size: Theme.small;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: identity.detail;
                                color: Theme.drift;
                                font-size: Theme.small;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-top: 6px;
                        spacing: 8px;

                        Field {
                            text <=> root.import-path;
                            placeholder: "path to a TeamSpeak identity file or folder";
                            accepted => {
                                root.import-identity();
                            }
                        }

                        Btn {
                            text: "Import";
                            clicked => {
                                root.import-identity();
                            }
                        }

                        Btn {
                            text: "Create an identity";
                            clicked => {
                                root.new-identity();
                            }
                        }
                    }

                    if root.identity-note != "": Hint {
                        text: root.identity-note;
                    }
                }

                if root.tab == 3: HorizontalLayout {
                    padding: 20px;
                    spacing: 18px;

                    VerticalLayout {
                        width: 236px;
                        spacing: 4px;
                        alignment: start;

                        for bookmark[i] in root.bookmarks: Pressable {
                            height: 44px;
                            border-radius: 8px;
                            background: i == root.bm-index || self.hovered ? Theme.current : Theme.shoal;
                            clicked => {
                                root.bookmark-picked(i);
                            }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 10px;
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;

                                    Tile {
                                        size: 30px;
                                        focusable: false;
                                        label: bookmark.initials;
                                        clicked => {
                                            root.bookmark-picked(i);
                                        }
                                    }
                                }

                                Text {
                                    text: bookmark.name;
                                    color: Theme.foam;
                                    font-size: Theme.text;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }

                        if root.bookmarks.length == 0: Hint {
                            text: "No bookmarks yet. Fill in the form to add one.";
                        }

                        Rectangle {
                            height: 6px;
                        }

                        Btn {
                            text: "Add a bookmark";
                            clicked => {
                                root.bookmark-new();
                            }
                        }

                        Rectangle {
                            height: 12px;
                        }

                        Divider { }

                        Check {
                            text: "Open ts3server:// links here";
                            checked <=> root.links-on;
                            toggled => {
                                root.links-changed();
                            }
                        }

                        Hint {
                            text: "Server links on web pages then open in PhishSpeak, which shows where a link leads before it connects. Switching this off gives the links back to the program that had them.";
                        }

                        if root.links-note != "": Hint {
                            text: root.links-note;
                            color: Theme.coral;
                        }
                    }

                    VerticalLayout {
                        alignment: start;
                        spacing: 5px;

                        Heading {
                            text: root.bm-index >= 0 ? "Edit bookmark" : "New bookmark";
                        }

                        HorizontalLayout {
                            spacing: 10px;

                            VerticalLayout {
                                min-width: 80px;
                                preferred-width: 180px;
                                horizontal-stretch: 1;
                                spacing: 5px;

                                Hint {
                                    text: "Name";
                                }

                                Field {
                                    text <=> root.bm-name;
                                    placeholder: "what to call it";
                                }
                            }

                            VerticalLayout {
                                min-width: 80px;
                                preferred-width: 180px;
                                horizontal-stretch: 1;
                                spacing: 5px;

                                Hint {
                                    text: "Nickname";
                                }

                                Field {
                                    text <=> root.bm-nickname;
                                    placeholder: "the name others see";
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;

                            VerticalLayout {
                                min-width: 80px;
                                preferred-width: 180px;
                                horizontal-stretch: 1;
                                spacing: 5px;

                                Hint {
                                    text: "Server address";
                                }

                                Field {
                                    text <=> root.bm-address;
                                    placeholder: "name or address, with :port";
                                }
                            }

                            VerticalLayout {
                                min-width: 80px;
                                preferred-width: 180px;
                                horizontal-stretch: 1;
                                spacing: 5px;

                                Hint {
                                    text: "Server password";
                                }

                                Field {
                                    text <=> root.bm-server-password;
                                    password: true;
                                    placeholder: "none";
                                }
                            }
                        }

                        Hint {
                            text: "Identity";
                        }

                        Dropdown {
                            model: root.identity-names;
                            current-index <=> root.bm-identity;
                            placeholder: "No identity yet";
                        }

                        HorizontalLayout {
                            spacing: 10px;

                            VerticalLayout {
                                min-width: 80px;
                                preferred-width: 180px;
                                horizontal-stretch: 1;
                                spacing: 5px;

                                Hint {
                                    text: "Channel to join";
                                }

                                Dropdown {
                                    model: root.bm-channels;
                                    current-index <=> root.bm-channel;
                                    selected => {
                                        root.bookmark-channel-selected();
                                    }
                                }
                            }

                            VerticalLayout {
                                min-width: 80px;
                                preferred-width: 180px;
                                horizontal-stretch: 1;
                                spacing: 5px;

                                Hint {
                                    text: "Its password";
                                }

                                Field {
                                    text <=> root.bm-channel-password;
                                    password: true;
                                    enabled: root.bm-channel > 0;
                                    placeholder: "none";
                                }
                            }
                        }

                        if root.bm-channel-hint != "": Hint {
                            text: root.bm-channel-hint;
                        }

                        Check {
                            text: "Connect when PhishSpeak starts";
                            checked <=> root.bm-auto;
                        }

                        Hint {
                            text: "Passwords are kept encrypted for your Windows account.";
                        }

                        if root.bm-note != "": Hint {
                            text: root.bm-note;
                            color: Theme.coral;
                        }

                        HorizontalLayout {
                            alignment: end;
                            padding-top: 10px;
                            spacing: 8px;

                            Btn {
                                text: "Remove";
                                danger: true;
                                enabled: root.bm-index >= 0;
                                clicked => {
                                    root.bookmark-removed();
                                }
                            }

                            Btn {
                                text: "Save bookmark";
                                enabled: root.bm-address != "";
                                clicked => {
                                    root.bookmark-saved();
                                }
                            }
                        }
                    }
                }

                if root.tab == 4 && !root.editor-open: shortcut-scroll := ScrollView {
                    content-width: self.visible-width;
                    content-height: max(shortcut-list.preferred-height, self.visible-height);

                    shortcut-list := VerticalLayout {
                        width: shortcut-scroll.visible-width;
                        alignment: start;
                        padding: 20px;
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 16px;

                            Caption {
                                text: "Talk keys";
                            }

                            VerticalLayout {
                                spacing: 6px;

                                HorizontalLayout {
                                    spacing: 8px;

                                    for name[i] in root.talk-keys: KeyChip {
                                        text: name;
                                        listening: root.listening == i;
                                        clicked => {
                                            root.talk-key-change(i);
                                        }
                                        removed => {
                                            root.talk-key-remove(i);
                                        }
                                    }

                                    if root.listening == 50: KeyChip {
                                        listening: true;
                                        removable: false;
                                        clicked => {
                                            root.talk-key-add();
                                        }
                                    }

                                    if root.listening != 50 && root.can-add-talk: VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 0;

                                        Btn {
                                            text: "Add a key";
                                            clicked => {
                                                root.talk-key-add();
                                            }
                                        }
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }
                                }

                                if root.shortcut-note != "" && root.shortcut-note-place == 0: Hint {
                                    text: root.shortcut-note;
                                    color: Theme.coral;
                                }

                                Hint {
                                    text: "Click a key, then press the key, mouse button or combination you want. Esc cancels. Works while PhishSpeak is in the background.";
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 16px;

                            Caption {
                                text: "After I let go";
                            }

                            VerticalLayout {
                                spacing: 4px;

                                HorizontalLayout {
                                    spacing: 10px;

                                    Slide {
                                        minimum: 0;
                                        maximum: 1000;
                                        step: 50;
                                        value <=> root.talk-release;
                                        changed => {
                                            root.shortcut-changed();
                                        }
                                    }

                                    Reading {
                                        text: root.talk-release-text;
                                    }
                                }

                                Hint {
                                    text: "Keeps sending for this long after you let go of a talk key or a whisper key, so the end of a word is not cut off.";
                                }
                            }
                        }

                        Divider { }

                        Heading {
                            text: "Whisper keys";
                        }

                        Hint {
                            text: "While you hold a whisper key, your voice goes to the people that key is aimed at, and not to your channel.";
                        }

                        for item[i] in root.whisper-keys: HorizontalLayout {
                            height: 34px;
                            spacing: 10px;

                            KeyChip {
                                width: 200px;
                                text: item.key;
                                empty-text: "No key yet";
                                removable: false;
                                listening: root.listening == 100 + i;
                                clicked => {
                                    root.whisper-key-change(i);
                                }
                            }

                            Text {
                                text: item.summary;
                                color: Theme.foam;
                                font-size: Theme.text;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            if item.note != "": Text {
                                text: item.note;
                                color: Theme.drift;
                                font-size: Theme.small;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            VerticalLayout {
                                alignment: center;

                                Btn {
                                    text: "Edit";
                                    clicked => {
                                        root.whisper-key-edit(i);
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;

                                Btn {
                                    text: "Remove";
                                    danger: true;
                                    clicked => {
                                        root.whisper-key-remove(i);
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;

                            Btn {
                                text: "Add a whisper key";
                                enabled: root.can-add-whisper;
                                clicked => {
                                    root.whisper-key-add();
                                }
                            }

                            if !root.can-add-whisper: Hint {
                                text: "Twelve is the most.";
                                vertical-alignment: center;
                            }

                            if root.shortcut-note != "" && root.shortcut-note-place == 1: Hint {
                                text: root.shortcut-note;
                                color: Theme.coral;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }

                        Divider { }

                        HorizontalLayout {
                            spacing: 16px;

                            Caption {
                                text: "Reply key";
                            }

                            VerticalLayout {
                                spacing: 6px;

                                HorizontalLayout {
                                    KeyChip {
                                        text: root.reply-key;
                                        listening: root.listening == 60;
                                        clicked => {
                                            root.reply-key-change();
                                        }
                                        removed => {
                                            root.reply-key-clear();
                                        }
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }
                                }

                                if root.shortcut-note != "" && root.shortcut-note-place == 2: Hint {
                                    text: root.shortcut-note;
                                    color: Theme.coral;
                                }

                                Hint {
                                    text: "Talks to whoever whispered to you last.";
                                }
                            }
                        }

                        Divider { }

                        HorizontalLayout {
                            spacing: 16px;

                            Caption {
                                text: "Mute keys";
                            }

                            VerticalLayout {
                                spacing: 6px;

                                HorizontalLayout {
                                    spacing: 10px;

                                    KeyChip {
                                        text: root.mute-mic-key;
                                        listening: root.listening == 61;
                                        clicked => {
                                            root.action-key-change(0);
                                        }
                                        removed => {
                                            root.action-key-clear(0);
                                        }
                                    }

                                    Hint {
                                        text: "microphone on and off";
                                        vertical-alignment: center;
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;

                                    KeyChip {
                                        text: root.mute-sound-key;
                                        listening: root.listening == 62;
                                        clicked => {
                                            root.action-key-change(1);
                                        }
                                        removed => {
                                            root.action-key-clear(1);
                                        }
                                    }

                                    Hint {
                                        text: "sound on and off";
                                        vertical-alignment: center;
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }
                                }

                                if root.shortcut-note != "" && root.shortcut-note-place == 3: Hint {
                                    text: root.shortcut-note;
                                    color: Theme.coral;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 16px;

                            Caption {
                                text: "Incoming whispers";
                            }

                            Check {
                                text: "Let others whisper to me";
                                checked <=> root.allow-whispers;
                                toggled => {
                                    root.shortcut-changed();
                                }
                            }
                        }
                    }
                }

                if root.editing: VerticalLayout {
                    padding: 20px;
                    padding-bottom: 16px;
                    spacing: 10px;

                    Heading {
                        text: root.editor-title;
                    }

                    HorizontalLayout {
                        spacing: 16px;

                        Caption {
                            text: "Whisper key";
                        }

                        KeyChip {
                            text: root.editor-key;
                            listening: root.listening == 70;
                            clicked => {
                                root.editor-key-change();
                            }
                            removed => {
                                root.editor-key-clear();
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }

                    HorizontalLayout {
                        spacing: 16px;

                        Caption {
                            text: "Whisper to";
                        }

                        Segmented {
                            options: ["Channels and people", "A group"];
                            current <=> root.editor-kind;
                            selected => {
                                root.editor-changed();
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }

                    if root.editor-kind == 0: Hint {
                        text: root.editor-hint;
                    }

                    if root.editor-kind == 0: Rectangle {
                        vertical-stretch: 1;
                        min-height: 84px;
                        border-radius: 8px;
                        background: Theme.trench;
                        border-width: 1px;
                        border-color: Theme.hairline;
                        clip: true;

                        ListView {
                            x: 4px;
                            y: 4px;
                            width: parent.width - 8px;
                            height: parent.height - 8px;

                            for row[i] in root.editor-rows: PickRowView {
                                entry: row;
                                clicked => {
                                    root.editor-toggle(i);
                                }
                            }
                        }

                        if root.editor-rows.length == 0: Text {
                            text: "Nothing to choose from yet";
                            color: Theme.drift;
                            font-size: Theme.text;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    if root.editor-kind == 1: HorizontalLayout {
                        spacing: 16px;

                        Caption {
                            text: "Who";
                        }

                        Dropdown {
                            model: ["Everyone", "Channel commanders", "A server group", "A channel group"];
                            current-index <=> root.editor-who;
                            selected => {
                                root.editor-changed();
                            }
                        }
                    }

                    if root.editor-kind == 1 && root.editor-who >= 2: HorizontalLayout {
                        spacing: 16px;

                        Caption {
                            text: "Group";
                        }

                        Dropdown {
                            model: root.editor-groups;
                            current-index <=> root.editor-group;
                            placeholder: root.editor-groups.length == 0 ? "Connect to a server to choose a group" : "Choose a group";
                            selected => {
                                root.editor-changed();
                            }
                        }
                    }

                    if root.editor-kind == 1: HorizontalLayout {
                        spacing: 16px;

                        Caption {
                            text: "Where";
                        }

                        VerticalLayout {
                            spacing: 5px;

                            Dropdown {
                                model: root.scope-names;
                                current-index <=> root.editor-scope;
                                selected => {
                                    root.editor-changed();
                                }
                            }

                            Hint {
                                text: root.scope-hints[root.editor-scope];
                            }
                        }
                    }

                    if root.editor-kind == 1: Rectangle {
                        vertical-stretch: 1;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Hint {
                            text: root.editor-note;
                            color: Theme.coral;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        Btn {
                            text: "Cancel";
                            clicked => {
                                root.editor-cancel();
                            }
                        }

                        Btn {
                            text: "Save whisper key";
                            primary: true;
                            enabled: root.editor-can-save;
                            clicked => {
                                root.editor-save();
                            }
                        }
                    }
                }

                if root.tab == 5: VerticalLayout {
                    alignment: start;
                    padding: 20px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 16px;

                        Caption {
                            text: "Channels start";
                        }

                        VerticalLayout {
                            spacing: 6px;

                            HorizontalLayout {
                                Segmented {
                                    options: ["All open", "Empty ones folded", "All folded"];
                                    current <=> root.fold-mode;
                                    selected => {
                                        root.view-changed();
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }

                            Hint {
                                text: root.fold-mode == 0 ? "Every channel shows the channels and people inside it." : (root.fold-mode == 2 ? "Every channel shows as one row with a count of the people inside. The way to your own channel stays open." : "A channel with other channels inside it shows as one row while nobody is in any of them.");
                            }

                            Hint {
                                text: "Click the arrow beside a channel to fold or open it yourself. PhishSpeak remembers that for each server, until you change this setting.";
                            }
                        }
                    }

                    Divider { }

                    HorizontalLayout {
                        spacing: 16px;

                        Caption {
                            text: "Speaking window";
                        }

                        VerticalLayout {
                            spacing: 2px;

                            Check {
                                text: "Show a small window with who is speaking";
                                checked <=> root.sp-shown;
                                toggled => {
                                    root.speakers-changed();
                                }
                            }

                            Check {
                                text: "Keep it above other windows";
                                checked <=> root.sp-on-top;
                                toggled => {
                                    root.speakers-changed();
                                }
                            }

                            Check {
                                text: "Lock its size and place, and let clicks pass through it";
                                checked <=> root.sp-locked;
                                toggled => {
                                    root.speakers-changed();
                                }
                            }

                            Check {
                                text: "List everyone in my channel, not only who is speaking";
                                checked <=> root.sp-all;
                                toggled => {
                                    root.speakers-changed();
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                padding-top: 4px;

                                Hint {
                                    width: 172px;
                                    text: "How solid it is";
                                    vertical-alignment: center;
                                }

                                Slide {
                                    minimum: 20;
                                    maximum: 100;
                                    step: 5;
                                    value <=> root.sp-opacity;
                                    changed => {
                                        root.speakers-changed();
                                    }
                                }

                                Reading {
                                    text: "\{round(root.sp-opacity)}%";
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;

                                Hint {
                                    width: 172px;
                                    text: "Keep a name after they stop";
                                    vertical-alignment: center;
                                }

                                Slide {
                                    minimum: 0;
                                    maximum: 60;
                                    step: 1;
                                    value <=> root.sp-linger;
                                    changed => {
                                        root.speakers-changed();
                                    }
                                }

                                Reading {
                                    text: "\{round(root.sp-linger)} s";
                                }
                            }

                            Hint {
                                text: "Move and size the window while it is unlocked. Once locked it stays hidden until someone speaks; unlock it here or from the server menu.";
                            }

                            Hint {
                                text: "It shows over games that run in a window or borderless window, not over exclusive full screen.";
                            }
                        }
                    }
                }

                if root.tab == 6: VerticalLayout {
                    alignment: start;
                    padding: 20px;
                    spacing: 10px;

                    Heading {
                        text: "PhishSpeak \{root.version}";
                    }

                    Hint {
                        text: "An unofficial TeamSpeak 3 client. It is not affiliated with or endorsed by TeamSpeak Systems GmbH; TeamSpeak is their trademark.";
                    }

                    Heading {
                        text: "Credits";
                        font-size: 13.5px;
                    }

                    Hint {
                        text: "The protocol knowledge comes from the ReSpeak projects tsdeclarations and tsclientlib, from TSLib in Splamy's TS3AudioBot, from Manevolent's ts3j, and from landave's TSIdentityTool.";
                    }

                    Hint {
                        text: "Built with Slint, Opus by the Xiph.Org Foundation through unsafe-libopus, cpal, the RustCrypto crates and curve25519-dalek. The README lists every source and its licence.";
                    }

                    HorizontalLayout {
                        alignment: start;

                        AboutSlint {
                            width: 200px;
                        }
                    }
                }
            }

            if !root.editing: Divider { }

            if !root.editing: HorizontalLayout {
                alignment: end;
                padding: 12px;
                padding-right: 18px;

                Btn {
                    text: "Done";
                    primary: true;
                    clicked => {
                        root.done();
                    }
                }
            }
        }
    }
}
