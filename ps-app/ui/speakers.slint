import "fonts/AtkinsonHyperlegibleNext-Regular.ttf";
import "fonts/AtkinsonHyperlegibleNext-Medium.ttf";
import "fonts/AtkinsonHyperlegibleNext-SemiBold.ttf";
import "fonts/AtkinsonHyperlegibleNext-Bold.ttf";
import { Theme, Icons } from "theme.slint";
import { Icon } from "widgets.slint";

export struct SpeakerRow {
    caption: bool,
    text: string,
    talking: bool,
    whispering: bool,
    me: bool,
    extra: int,
}

component EditButton inherits Rectangle {
    in property <image> icon;
    callback clicked();

    width: 24px;
    height: 24px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.hairline;
    background: touch.has-hover ? Theme.current : Theme.shoal;

    Icon {
        source: root.icon;
        tint: touch.has-hover ? Theme.foam : Theme.drift-bright;
        width: 14px;
        height: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component SpeakersWindow inherits Window {
    in property <[SpeakerRow]> rows;
    in property <bool> locked;
    in property <bool> on-top: true;
    in property <float> scale-nudge;
    in property <int> slots;
    in property <string> placing;
    in property <bool> event-line;
    in property <int> event-kind;
    in property <string> event-name;
    in property <string> event-what;
    in property <string> event-age;
    property <int> speaker-slots: root.slots - (root.event-line ? 1 : 0);
    callback lock-asked();
    callback hide-asked();
    callback dragged(dx: length, dy: length);
    callback sized(width: length, height: length);

    title: "Parrotfish speaking";
    no-frame: true;
    always-on-top: root.on-top;
    preferred-width: 220px;
    preferred-height: 160px;
    min-width: 120px + root.scale-nudge * 0.01px;
    min-height: 38px;
    background: Theme.trench;
    default-font-size: Theme.text;
    default-font-family: Theme.font;

    Rectangle {
        clip: true;

        VerticalLayout {
            padding: 8px;
            spacing: 0px;
            alignment: start;

            for row in root.rows: Rectangle {
                height: 22px;
                border-radius: 5px;
                background: row.caption || !row.talking ? transparent : (row.whispering ? Theme.whisper.with-alpha(0.16) : Theme.lure.with-alpha(0.12));
                border-width: row.caption ? 0px : 1px;
                border-color: row.talking ? (row.whispering ? Theme.whisper.with-alpha(0.47) : Theme.lure.with-alpha(0.47)) : (row.whispering ? Theme.whisper.with-alpha(0.35) : Theme.person.with-alpha(0.27));

                HorizontalLayout {
                    padding-left: row.caption ? 0px : 4px;
                    padding-right: 4px;
                    spacing: 7px;

                    if !row.caption: VerticalLayout {
                        alignment: center;

                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: row.talking ? (row.whispering ? Theme.whisper : Theme.lure) : transparent;
                            border-width: row.talking ? 0px : 1px;
                            border-color: row.whispering ? Theme.whisper : Theme.person-dot;
                        }
                    }

                    Text {
                        text: row.text;
                        color: row.caption ? Theme.drift : (row.talking ? (row.whispering ? Theme.whisper-text : Theme.lure) : (row.whispering ? Theme.whisper-text : Theme.person));
                        font-size: row.caption ? Theme.small : Theme.text;
                        font-weight: row.caption ? 500 : (row.me ? 700 : 600);
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    if row.whispering: Text {
                        text: "whisper";
                        color: Theme.whisper-text;
                        font-size: Theme.small;
                        vertical-alignment: center;
                    }

                    if row.extra > 0: Text {
                        text: "+\{row.extra}";
                        color: Theme.drift;
                        font-size: Theme.small;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }

            for slot in (root.locked ? 0 : max(0, root.speaker-slots - root.rows.length)): Rectangle {
                height: 22px;

                Rectangle {
                    y: 2px;
                    height: 18px;
                    width: root.rows.length + slot == 0 ? parent.width - 62px : parent.width;
                    border-radius: 5px;
                    border-width: 1px;
                    border-color: Theme.drift.with-alpha(0.28);

                    Text {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text: root.rows.length + slot == 0
                            ? (root.placing != "" ? "1   Placing for \{root.placing}" : "1   Drag me into place, then lock me")
                            : "\{root.rows.length + slot + 1}";
                        color: Theme.drift;
                        font-size: Theme.small;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }

        if root.event-line && (root.event-kind > 0 || !root.locked): Rectangle {
            x: 8px;
            y: parent.height - 8px - 22px;
            width: parent.width - 16px;
            height: 22px;

            Rectangle {
                x: 2px;
                width: parent.width - 4px;
                height: 1px;
                background: Theme.hairline;
            }

            if root.event-kind == 0: Rectangle {
                y: 2px;
                height: 18px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Theme.drift.with-alpha(0.28);

                Text {
                    x: 8px;
                    width: parent.width - 16px;
                    text: "Joins and leaves show here";
                    color: Theme.drift;
                    font-size: Theme.small;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            if root.event-kind > 0: HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                spacing: 7px;

                VerticalLayout {
                    alignment: center;

                    Icon {
                        source: root.event-kind == 1 ? Icons.arrow-in : Icons.arrow-out;
                        tint: root.event-kind == 1 ? Theme.person-dot : Theme.coral;
                        width: 12px;
                        height: 12px;
                    }
                }

                Text {
                    text: root.event-name;
                    color: Theme.foam;
                    font-size: Theme.small;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 0;
                }

                Text {
                    text: root.event-what;
                    color: Theme.drift;
                    font-size: Theme.small;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Text {
                    text: root.event-age;
                    color: Theme.drift;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }
    }

    if !root.locked: Rectangle {
        border-width: 1px;
        border-radius: 8px;
        border-color: Theme.lure;

        TouchArea {
            mouse-cursor: move;
            moved => {
                if (self.pressed) {
                    root.dragged(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                }
            }
        }

        EditButton {
            x: parent.width - 60px;
            y: 6px;
            icon: Icons.lock;
            clicked => {
                root.lock-asked();
            }
        }

        EditButton {
            x: parent.width - 32px;
            y: 6px;
            icon: Icons.close;
            clicked => {
                root.hide-asked();
            }
        }

        grip := Rectangle {
            x: parent.width - self.width;
            y: parent.height - self.height;
            width: 20px;
            height: 20px;

            Rectangle {
                x: 5px;
                y: 13px;
                width: 11px;
                height: 3px;
                background: Theme.lure;
            }

            Rectangle {
                x: 13px;
                y: 5px;
                width: 3px;
                height: 11px;
                background: Theme.lure;
            }

            TouchArea {
                mouse-cursor: nwse-resize;
                moved => {
                    if (self.pressed) {
                        root.sized(grip.x + self.mouse-x + grip.width - self.pressed-x, grip.y + self.mouse-y + grip.height - self.pressed-y);
                    }
                }
            }
        }
    }
}
